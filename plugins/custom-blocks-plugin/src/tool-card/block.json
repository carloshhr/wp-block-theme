{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "custom-blocks/tool-card",
  "version": "0.1.0",
  "title": "Tool Card",
  "category": "widgets",
  "icon": "editor-code",
  "description": "An expandable tool and its plain-text description.",
  "attributes": {
    "title": { "type": "string", "default": "Tool name" },
    "description": { "type": "string", "default": "Describe this tool." }
  },
  "supports": { "interactivity": true },
  "textdomain": "custom-blocks-plugin",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js"
}
